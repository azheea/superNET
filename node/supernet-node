#!/usr/bin/env bash
# supernet-node: manage the clients (peers) of a superNET node.
#
#   supernet-node peer add NAME [--dns "1.1.1.1, 8.8.8.8"]
#   supernet-node peer list
#   supernet-node peer show NAME
#   supernet-node peer remove NAME
#   supernet-node status
#
# Runs and exits; nothing stays resident. Changes are applied with
# `wg syncconf`, so existing clients keep their sessions.
set -euo pipefail

STATE_DIR=/etc/supernet
WG_CONF=/etc/wireguard/wg0.conf
DEFAULT_DNS="1.1.1.1, 8.8.8.8"

die() { printf '\033[1;31m错误:\033[0m %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" = 0 ] || die "请用 root 运行"
[ -f "$STATE_DIR/node.env" ] || die "还没有安装节点，先运行 install.sh"
. "$STATE_DIR/node.env"

apply() {
    wg syncconf wg0 <(wg-quick strip wg0)
}

valid_name() {
    [[ -n "$1" && ${#1} -le 32 && "$1" != *[[:space:]/,\\]* ]]
}

peer_exists() {
    grep -qxF "# supernet-peer $1" "$WG_CONF"
}

next_ip() {
    local base=${SUBNET%/*} prefix=${SUBNET#*/}
    local net=${base%.*} start=${base##*.}
    local size=$(( 1 << (32 - prefix) ))
    local used i ip
    used=$(grep -oE 'AllowedIPs = [0-9.]+' "$WG_CONF" | awk '{print $3}')
    # .0 is the network, .1 the server, the last address the broadcast.
    for (( i = start + 2; i < start + size - 1 && i < 255; i++ )); do
        ip="$net.$i"
        grep -qxF "$ip" <<<"$used" || { echo "$ip"; return; }
    done
    die "子网 $SUBNET 已经没有空闲地址"
}

percent_encode() {
    local LC_ALL=C out="" byte
    for byte in $(printf '%s' "$1" | od -An -tx1); do
        case "$byte" in
            3[0-9]|4[1-9a-f]|5[0-9a]|6[1-9a-f]|7[0-9a]|2d|2e|5f|7e) out+=$(printf "\\x$byte") ;;
            *) out+="%${byte^^}" ;;
        esac
    done
    printf '%s' "$out"
}

print_client() {
    local name=$1 conf=$STATE_DIR/peers/$1.conf
    echo "===== $name：WireGuard 配置 ====="
    cat "$conf"
    echo
    echo "===== $name：supernet:// 链接（在 superNET 的“节点”页粘贴）====="
    printf 'supernet://%s#%s\n' "$(base64 -w0 < "$conf" | tr '+/' '-_' | tr -d '=')" "$(percent_encode "$name")"
    if command -v qrencode >/dev/null; then
        echo
        echo "===== $name：二维码（WireGuard 官方 App 可直接扫描）====="
        qrencode -t ansiutf8 < "$conf"
    fi
    echo "注意：以上内容包含这个客户端的私钥，只发给你自己的设备。"
}

peer_add() {
    local name=${1:-} dns=$DEFAULT_DNS
    shift || true
    while [ $# -gt 0 ]; do
        case "$1" in
            --dns) dns=$2; shift 2 ;;
            *) die "未知参数 $1" ;;
        esac
    done
    valid_name "$name" || die "名称不能为空、不超过 32 个字符，且不能含空格、/、\\、逗号"
    peer_exists "$name" && die "已经有名为 $name 的客户端（supernet-node peer show $name 查看）"

    umask 077
    local ip key pub psk endpoint
    ip=$(next_ip)
    key=$(wg genkey)
    pub=$(wg pubkey <<<"$key")
    psk=$(wg genpsk)
    endpoint=$ENDPOINT
    [[ "$endpoint" == *:* ]] && endpoint="[$endpoint]"

    printf '\n# supernet-peer %s\n[Peer]\nPublicKey = %s\nPresharedKey = %s\nAllowedIPs = %s/32\n' \
        "$name" "$pub" "$psk" "$ip" >> "$WG_CONF"

    cat > "$STATE_DIR/peers/$name.conf" <<EOF
[Interface]
PrivateKey = $key
Address = $ip/32
DNS = $dns
MTU = $MTU

[Peer]
PublicKey = $(cat "$STATE_DIR/server.pub")
PresharedKey = $psk
Endpoint = $endpoint:$PORT
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25
EOF
    apply
    echo "已添加 $name（隧道地址 $ip）"
    echo
    print_client "$name"
}

peer_remove() {
    local name=${1:-}
    peer_exists "$name" || die "没有名为 $name 的客户端"
    cp "$WG_CONF" "$WG_CONF.bak"
    # Drop the marker line and the [Peer] block after it (up to the next blank line).
    awk -v marker="# supernet-peer $name" '
        $0 == marker { skip = 1; next }
        skip && /^[[:space:]]*$/ { skip = 0; next }
        !skip
    ' "$WG_CONF.bak" > "$WG_CONF"
    chmod 600 "$WG_CONF"
    rm -f "$STATE_DIR/peers/$name.conf"
    apply
    echo "已删除 $name（旧配置备份在 $WG_CONF.bak）"
}

peer_list() {
    local now
    now=$(date +%s)
    printf '%-20s %-15s %-14s %12s %12s\n' 名称 地址 最近握手 接收 发送
    awk '/^# supernet-peer /{name=substr($0, 17)} /^PublicKey/{pub=$3} /^AllowedIPs/{split($3, a, "/"); print name, pub, a[1]}' "$WG_CONF" |
    while read -r name pub ip; do
        local hs rx tx age
        read -r hs rx tx < <(wg show wg0 dump | awk -v p="$pub" '$1 == p {print $5, $6, $7}')
        if [ "${hs:-0}" = 0 ]; then age="从未"; else age="$(( now - hs )) 秒前"; fi
        printf '%-20s %-15s %-14s %12s %12s\n' "$name" "$ip" "$age" "$(numfmt --to=iec "${rx:-0}")" "$(numfmt --to=iec "${tx:-0}")"
    done
}

status() {
    echo "== WireGuard"
    wg show wg0 | sed -n '1,4p'
    echo "客户端数：$(grep -c '^# supernet-peer ' "$WG_CONF" || true)"
    echo "== 资源"
    free -m | awk '/Mem:/{printf "内存：已用 %d MB / 共 %d MB（可用 %d MB）\n", $3, $2, $7}'
    echo "负载：$(cut -d' ' -f1-3 /proc/loadavg)"
    printf '连接跟踪：%s / %s\n' "$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo ?)" "$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null || echo ?)"
    echo "拥塞控制：$(cat /proc/sys/net/ipv4/tcp_congestion_control)"
    echo "转发：$(cat /proc/sys/net/ipv4/ip_forward)"
}

case "${1:-} ${2:-}" in
    "peer add") shift 2; peer_add "$@" ;;
    "peer list") peer_list ;;
    "peer show") peer_exists "${3:-}" || die "没有名为 ${3:-} 的客户端"; print_client "$3" ;;
    "peer remove") peer_remove "${3:-}" ;;
    "status "*) status ;;
    *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
