{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "superNET",
  "version": "0.1.1",
  "identifier": "app.supernet.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "superNET", "width": 1040, "height": 720, "minWidth": 820, "minHeight": 600, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns", "icons/icon.png"] }
}
